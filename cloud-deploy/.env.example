# ============================================
# 云端中间件配置模板 — 复制为 .env 并修改密码
# 所有密码建议 12 位以上，含大小写字母+数字
# 密码不要包含 $ / 空格 等特殊字符（会被 compose 解析出问题）
# ============================================

# MySQL root 密码（本地备份工具/导入导出用）
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026

# Redis 访问密码（Java application.yml 里要用同一个）
REDIS_PASSWORD=ChangeMe_Redis_2026

# RabbitMQ 专用账号（不用 guest）
RABBITMQ_USER=antique_app
RABBITMQ_PASSWORD=ChangeMe_Mq_2026