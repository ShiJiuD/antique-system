<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.antique</groupId>
    <artifactId>antique-api</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Antique — 父工程</name>

    <modules>
        <module>antique-common</module>
        <module>antique-pojo</module>
        <module>antique-server</module>
        <!-- M5：把搜索能力拆成独立服务
             理由：它依赖 ES（技术栈异构）、读多写少（负载特征不同）、
             且挂掉不该影响下单（故障隔离）—— 不是"为了微服务而拆" -->
        <module>antique-search</module>
        <!-- M5：网关 —— 前端只连它，由它按路径把请求分发到各服务（统一入口） -->
        <module>antique-gateway</module>
    </modules>

    <!-- ========== 所有版本号统一在这里 ========== -->
    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <knife4j.version>4.4.0</knife4j.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <aliyun-oss.version>3.17.4</aliyun-oss.version>
        <lombok.version>1.18.46</lombok.version>
        <hutool.version>5.8.26</hutool.version>
        <redisson.version>3.25.2</redisson.version>
        <!-- ===== M5 微服务：Spring Cloud / Spring Cloud Alibaba =====
             版本对应关系见官方表：https://sca.aliyun.com/docs/2023/overview/version-explain/
               SCA 2023.0.1.0 → Spring Cloud 2023.0.1 → Spring Boot 3.2.4（3.2.x 均可）
             它适配的 Nacos 服务端版本是 2.3.2，与本项目虚拟机上的 Nacos 完全一致 -->
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
    </properties>

    <dependencies>
        <!-- 全局所有子模块自动继承AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>

    <!-- ========== 统一管理所有依赖版本，子模块不用写 version ========== -->
    <dependencyManagement>
        <dependencies>
            <!-- ===== Spring Cloud / Spring Cloud Alibaba BOM（M5 微服务）=====
                 用 BOM 统一管理这一整套依赖的版本，子模块只写 artifactId 不写 version -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.antique</groupId>
                <artifactId>antique-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.antique</groupId>
                <artifactId>antique-pojo</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- MyBatis Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Knife4j 接口文档 -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- BCrypt 密码加密 -->
            <dependency>
                <groupId>org.mindrot</groupId>
                <artifactId>jbcrypt</artifactId>
                <version>${jbcrypt.version}</version>
            </dependency>

            <!-- 阿里云 OSS -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun-oss.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Redisson（分布式锁 + 延迟队列：订单超时自动取消） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

    <!-- ========== 编译插件只配一次，三个子模块自动继承 ========== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
